# Copy to .env and fill in. Do not commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

NEXTAUTH_URL="http://localhost:3000"
# Optional: public site origin for email/join links if NEXTAUTH_URL is unset (e.g. same as production URL).
# PUBLIC_APP_URL="https://your-domain.example"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Optional dedicated secret for the Election & Polling Module voting-session and
# post-vote “thanks” cookies (HMAC-SHA256 signing keys). When unset, NEXTAUTH_SECRET
# / AUTH_SECRET is used. Rotate this independently if you want to invalidate every
# issued voting cookie without forcing a workspace-wide sign-out. Minimum length 16 characters.
# POLL_VOTING_SESSION_SECRET="another-long-random-string"

# Shared secret for scheduled jobs (Authorization: Bearer …). Used by /api/cron/* routes.
# NOT from any vendor — generate yourself, e.g.  openssl rand -hex 32
# Put the same value in server crontab (see scripts/crontab.eventflow.example).
CRON_SECRET="generate-with-openssl-rand-hex-32"
# Optional: NextAuth v5 also accepts AUTH_SECRET
# AUTH_SECRET="same-as-above-or-separate"

RESEND_API_KEY=""
# Optional: RESEND_FROM="Eventflow <onboarding@resend.dev>"
# Signing secret from Resend → Webhooks → your endpoint → Signing secret (whsec_…).
# Required for POST /api/webhooks/resend (marketing unsubscribe + delivery sync).
RESEND_WEBHOOK_SECRET=""
# Set to true after validating Resend Segments/Broadcasts API calls in a test account.
BROADCAST_LIVE_SEND_ENABLED="false"
# Continues PREPARING campaigns: GET /api/cron/broadcast-send (uses CRON_SECRET above).

# ─── Paystack billing (subscriptions, GHS) ───────────────────────────────────
# Server secret for API calls + webhook signature verify (unless PAYSTACK_WEBHOOK_SECRET is set).
# PAYSTACK_SECRET_KEY=""
# Optional dedicated webhook signing secret from Paystack dashboard.
# PAYSTACK_WEBHOOK_SECRET=""
# Public key for client checkout initialization (Phase 2+).
# PAYSTACK_PUBLIC_KEY=""
# Paystack plan code for flat monthly PRO (create in Paystack dashboard).
# PAYSTACK_PRO_PLAN_CODE=""
# Paystack plan code for yearly PRO (GHS). Required for renew monthly↔yearly switch.
# PAYSTACK_PRO_YEARLY_PLAN_CODE=""
# Billing lifecycle + dunning crons (also use CRON_SECRET):
#   GET /api/cron/billing/lifecycle
#   GET /api/cron/billing/dunning
# Webhook endpoint: POST /api/webhooks/paystack
# Seller identity on Tax Invoice / Receipt PDFs and payment receipt emails.
# EVENTFLOW_BILLING_LEGAL_NAME defaults to "Cosabonita" when unset.
# EVENTFLOW_BILLING_LEGAL_NAME="Cosabonita"
# GRA VAT registration / TIN — required in production before customer receipts ship.
# Without this, production blocks receipt email + PDF download (placeholder OK in non-production).
# EVENTFLOW_BILLING_VAT_TIN=""

# ─── Optional module feature flags (default: enabled when unset) ───────────────
# Set to false/0/off to hide routes, nav links, and server actions for a module.
# Marketing consent + Resend unsubscribe webhooks stay active when broadcast is off.
MODULE_BROADCAST_ENABLED="true"
MODULE_CRM_ENABLED="true"
MODULE_MEDIA_ENABLED="true"
MODULE_DELIVERIES_ENABLED="true"
MODULE_ANALYTICS_ENABLED="true"
MODULE_POLLING_ENABLED="true"
MODULE_FEEDBACK_ENABLED="true"

# ─── mNotify (SMS) — https://developer.mnotify.com/ — optional server-wide fallbacks when the org has not saved values in Settings → Integrations.
# MNOTIFY_API_KEY — used when the organization has no stored mNotify API key (or after you clear the org key in Settings).
# MNOTIFY_DEFAULT_SENDER_ID — used when the organization has no stored sender ID (required value: 3–11 alphanumeric characters; no in-code default).
# MNOTIFY_API_KEY=""
# MNOTIFY_DEFAULT_SENDER_ID=YourSender

# ─── Zoom (fallback when org has no Zoom in Settings → Integrations) ─────────
# Server-to-Server OAuth app: Client ID, Client Secret, Account ID from Zoom Marketplace.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_ACCOUNT_ID=""
# Licensed Zoom user email or `me` — host for created webinars/meetings (must match webinar/meeting product on account).
# ZOOM_HOST_USER_ID="me"

# Public attendee page redesign + phase 1 editor (agenda/speakers/resources).
# Set to 1/true to enable.
# NEXT_PUBLIC_EVENT_PUBLIC_EXPERIENCE_V1="0"
