// =====================================================================
// Election & Polling Module
// ---------------------------------------------------------------------
// Architectural contract (do NOT relax without revisiting the threat model):
//
//   - {@link Poll} is 1-1 with {@link Event} (`@@unique eventId`). Optional —
//     organizers create it lazily when opening the poll tab.
//   - {@link PollPosition} represents a contest (e.g. "President"). It has
//     1..n {@link PollCandidate} rows. A position with exactly one candidate
//     is rendered as an unopposed "Confidence Vote" (Yes / No / Abstain).
//   - {@link Vote} is the secret-ballot table. It MUST NOT carry a guestId
//     or userId column (or any FK back to a person). The only Guest-side
//     trace of participation is the {@link Guest.hasVoted} boolean, which
//     records *that* the guest voted, not *what* they voted for.
//   - {@link BallotChoice} is the OPTIONAL attribution table. It is written
//     ONLY when the organizer explicitly disables anonymity for the poll
//     (`Poll.isAnonymous = false`). In anonymous mode it is never written
//     to — guest attribution literally never touches the database. When
//     non-anonymous it mirrors {@link Vote} 1-to-1 inside the same Prisma
//     transaction so the two datasets cannot diverge.
//   - {@link PollVerification} is the identity gate (guest + 6-digit OTP +
//     expiry + isUsed). It is destroyed/invalidated atomically with the
//     vote write so a verification row can never be replayed.
// =====================================================================

/**
 * Election & polling add-on for an Event (1-1 via {@link eventId}). When `isActive`
 * is false the public voting route is hard-closed regardless of the window. The
 * window `startTime`..`endTime` is the authoritative ballot-open period.
 */
model Poll {
  id                      String         @id @default(cuid())
  eventId                 String         @unique
  event                   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /**
   * Public-facing ballot title (e.g. "AGM Elections 2026"). Defaults to the event name.
   */
  title                   String
  /**
   * Optional preamble shown on the voting page above the positions list.
   * Editorial intro ("Why we're voting"); pairs with `instructions` (procedural).
   */
  description             String?        @db.Text
  /**
   * Optional procedural instructions shown to voters (e.g. "You'll get a 6-digit
   * OTP by email — codes expire in 10 minutes. Make a choice for every position
   * before submitting; ballots can't be edited once cast."). Rendered as a
   * highlighted callout above the positions list on the public election section,
   * the OTP gate, and the ballot itself. Plain text — whitespace preserved.
   */
  instructions            String?        @db.Text
  /**
   * Master switch — when false the gate + ballot routes return a "closed" state.
   */
  isActive                Boolean        @default(false)
  /**
   * When true, the election section appears on the public registration page.
   * Independent of `isActive` (voting pause only affects ballot access, not visibility).
   */
  publicElectionPublished Boolean        @default(false)
  /**
   * Window when ballots will be accepted. Both are required so the UI can render the
   * "opens in / closes in" countdown without ambiguity.
   */
  startTime               DateTime
  endTime                 DateTime
  /**
   * When the admin published the results to attendees (email + SMS broadcast). While
   * this is null, the public results URL responds with a "results not yet published"
   * notice. Setting it activates `/events/[id]/poll/results` for anyone with the link.
   */
  resultsPublishedAt      DateTime?
  /**
   * Optional narrative shown above the results breakdown — congratulating winners,
   * thanking voters, etc. Plain text rendered with whitespace preserved.
   */
  resultsSummary          String?        @db.Text
  /**
   * Anonymity switch.
   * true  (default) → ONLY {@link Vote} rows are written; no guest attribution stored.
   * Admins see aggregate tallies only. Receipt is a participation
   * proof token, not a link to choices.
   * false           → ALSO writes {@link BallotChoice} rows (guest ↔ position ↔ pick)
   * so admins can see who voted what, and the receipt email/SMS
   * echoes the voter's selections back to them.
   * Changing this AFTER votes have been cast does not retroactively reveal/hide
   * anything — write-time decides what gets persisted.
   */
  isAnonymous             Boolean        @default(true)
  positions               PollPosition[]
  votes                   Vote[]
  ballotChoices           BallotChoice[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([eventId, isActive])
}

/**
 * A single contest on the ballot (e.g. "President", "General Secretary"). Position
 * with exactly one candidate is rendered as an unopposed "Confidence Vote".
 */
model PollPosition {
  id            String          @id @default(cuid())
  pollId        String
  poll          Poll            @relation(fields: [pollId], references: [id], onDelete: Cascade)
  title         String
  /**
   * Optional context shown under the title (term length, mandate, etc).
   */
  description   String?         @db.Text
  /**
   * Render order on the ballot (ascending). Ties broken by createdAt asc.
   */
  sortOrder     Int             @default(0)
  candidates    PollCandidate[]
  votes         Vote[]
  ballotChoices BallotChoice[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([pollId, sortOrder])
}

/**
 * A nominee for a {@link PollPosition}. `photoUrl` is an https URL stored elsewhere
 * (Eventflow upload service or external CDN); `bio` is plain text or lightweight
 * markdown rendered safely on the public ballot.
 */
model PollCandidate {
  id            String         @id @default(cuid())
  positionId    String
  position      PollPosition   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  name          String
  /**
   * Current organizational role / title shown under the candidate name on the public
   * profile (e.g. "Director of Global Strategy"). Distinct from `PollPosition.title`
   * which is the role they are running for.
   */
  role          String?
  photoUrl      String?
  bio           String?        @db.Text
  /**
   * Optional supporting document — typically a CV, manifesto, or biography PDF.
   * `resourceUrl` is an https URL or a `/uploads/...` relative path; `resourceName`
   * is the display label rendered on the public profile.
   */
  resourceUrl   String?
  resourceName  String?
  /**
   * Render order on the candidate grid (ascending). Ties broken by createdAt asc.
   */
  sortOrder     Int            @default(0)
  votes         Vote[]
  ballotChoices BallotChoice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([positionId, sortOrder])
}

/**
 * Anonymized ballot row. CRITICAL: this table carries NO FK back to Guest or User.
 * Semantics per row:
 * - Opposed contest (position has ≥2 candidates):
 * candidateId      = the picked candidate
 * confidenceChoice = null
 * - Unopposed contest (position has exactly 1 candidate):
 * candidateId      = the sole candidate (for YES votes) or null (for NO / ABSTAIN)
 * confidenceChoice = YES | NO | ABSTAIN
 * `pollId` is denormalized for fast `votes per poll` queries; it is always equal to
 * `position.pollId` and is enforced by the submission server action.
 */
model Vote {
  id               String                @id @default(cuid())
  pollId           String
  poll             Poll                  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  positionId       String
  position         PollPosition          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateId      String?
  candidate        PollCandidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  /**
   * Unopposed confidence selection. MUST be null for opposed contests and MUST be
   * non-null for unopposed contests.
   */
  confidenceChoice VoteConfidenceChoice?
  createdAt        DateTime              @default(now())

  @@index([pollId])
  @@index([positionId])
  @@index([candidateId])
}

/**
 * Attributed ballot row — written ONLY when {@link Poll.isAnonymous} is false. Mirrors
 * the anonymized {@link Vote} table 1-to-1 per submission (one row per position) but
 * adds the `guestId` link so admins can audit how each guest voted and so the receipt
 * email/SMS can echo the voter's selections back to them.
 * The two tables are written in a single Prisma transaction at submission time, so the
 * datasets are guaranteed consistent within a non-anonymous poll. When `isAnonymous`
 * is true this table simply stays empty for that poll — guest attribution literally
 * never touches the database.
 * Semantics per row match {@link Vote}: for an opposed contest `candidateId` is the
 * pick and `confidenceChoice` is null; for an unopposed contest `confidenceChoice` is
 * YES/NO/ABSTAIN and `candidateId` is the sole candidate (YES) or null (NO/ABSTAIN).
 * `receiptRef` is the per-submission UUID also returned to the voter — it is shared
 * across all rows from the same ballot submission so we can group "the choices on
 * receipt X" with a single index lookup.
 */
model BallotChoice {
  id               String                @id @default(cuid())
  pollId           String
  poll             Poll                  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  positionId       String
  position         PollPosition          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateId      String?
  candidate        PollCandidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  confidenceChoice VoteConfidenceChoice?
  guestId          String
  guest            Guest                 @relation(fields: [guestId], references: [id], onDelete: Cascade)
  receiptRef       String
  createdAt        DateTime              @default(now())

  @@unique([pollId, positionId, guestId])
  @@index([pollId, guestId])
  @@index([guestId])
  @@index([candidateId])
  @@index([receiptRef])
}

/**
 * OTP record minted by `requestVotingOTP(email, eventId)` and consumed atomically
 * by the ballot submission. One guest may have multiple historical rows (resends,
 * expired codes); only one row may be `!isUsed && expiresAt > now()` at a time —
 * enforced in the server action by invalidating prior rows on resend.
 */
model PollVerification {
  id              String    @id @default(cuid())
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId         String
  guest           Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  /**
   * Lowercased email used to resolve the guest; stored for audit + rate limit lookup.
   */
  email           String
  /**
   * bcrypt hash of the 6-digit code. The plaintext is only ever held in memory long
   * enough to deliver via email/SMS and is then discarded — mirrors the sign-in OTP
   * pattern in {@link src/auth.ts} so a DB dump leaks zero usable codes.
   */
  codeHash        String
  /**
   * "email" | "whatsapp" — which provider delivered the code. UI uses this to label
   * the resend button ("Resend on WhatsApp" vs "Resend by email").
   */
  deliveryChannel String?   @db.VarChar(24)
  expiresAt       DateTime
  isUsed          Boolean   @default(false)
  /**
   * Increments on each verifyVotingOTP failure for this row; the server action
   * throws after a hard cap to defeat brute force.
   */
  attemptCount    Int       @default(0)
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([eventId, email])
  @@index([guestId, isUsed])
  @@index([expiresAt])
}

/**
 * Confidence-vote selections for an unopposed {@link PollPosition}.
 */
enum VoteConfidenceChoice {
  YES
  NO
  ABSTAIN
}

