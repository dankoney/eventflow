  SKIPPED_UNSUBSCRIBED
}

/**
 * Bridges a {@link Guest} to marketing-email state (subscription, Resend contact id).
 * One row per guest; email is denormalized for send/segment queries.
 */
model EmailContact {
  id                 String                   @id @default(cuid())
  guestId            String                   @unique
  guest              Guest                    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  email              String
  isSubscribed       Boolean                  @default(false)
  unsubscribedAt     DateTime?
  unsubscribeSource  EmailUnsubscribeSource?
  resendContactId     String?
  /**
   * When marketing consent was recorded (distinct from transactional invite/RSVP email).
   * Null until an explicit opt-in is captured.
   */
  consentRecordedAt  DateTime?
  /**
   * Touchpoint that captured marketing opt-in.
   */
  consentSource      EmailMarketingConsentSource?
  campaignRecipients EmailCampaignRecipient[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([email])
  @@index([isSubscribed])
}

/**
 * Maily editor document + compiled HTML for broadcast sends.
 */
model EmailTemplate {
  id              String          @id @default(cuid())
  orgId           String
  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?         @db.Text
  /**
   * Maily native document JSON.
   */
  editorState     Json
  /**
   * Rendered HTML sent to Resend; must include {{{RESEND_UNSUBSCRIBE_URL}}}.
   */
  compiledHtml    String          @db.Text
  thumbnailUrl    String?
  isPrebuilt      Boolean         @default(false)
  createdByUserId String
  createdBy       User            @relation("EmailTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  campaigns       EmailCampaign[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orgId, updatedAt])
  @@index([orgId, isPrebuilt])
}

/**
 * A marketing broadcast send (draft → scheduled → sent via Resend).
 */
model EmailCampaign {
  id                String                   @id @default(cuid())
  orgId             String
  org               Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String
  subject           String
  templateId        String
  template          EmailTemplate            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /**
   * Segment filter snapshot, e.g. { eventId, ticketTypes, rsvpStatus }.
   */
  segmentDefinition Json
  status            EmailCampaignStatus      @default(DRAFT)
  scheduledAt       DateTime?
  sentAt            DateTime?
  resendBroadcastId String?
  resendAudienceId  String?
  /**
   * Last terminal error during prepare/send (e.g. Resend API failure mid-sync).
   */
  sendError         String?                  @db.Text
  /**
   * Cron/worker lock — set while a batch or finalize step is in flight.
   * Stale locks (older than ~10 min) may be reclaimed by another worker.
   */
  sendProcessingStartedAt DateTime?
  /**
   * POST /broadcasts finalize attempts after all contacts are synced to the segment.
   */
  finalizeAttemptCount    Int                      @default(0)
  lastFinalizeAttemptAt   DateTime?
  createdByUserId   String
  createdBy         User                     @relation("EmailCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  recipients        EmailCampaignRecipient[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([orgId, status, updatedAt])
  @@index([templateId])
  @@index([status, sendProcessingStartedAt])
}

/**
 * Per-recipient send + engagement state derived from Resend webhooks.
 */
model EmailCampaignRecipient {
  id             String                       @id @default(cuid())
  campaignId     String
  campaign       EmailCampaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailContactId String
  emailContact   EmailContact                 @relation(fields: [emailContactId], references: [id], onDelete: Cascade)
  status         EmailCampaignRecipientStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  bouncedAt      DateTime?
  openedAt       DateTime?
  firstClickedAt DateTime?
  /**
   * Resend per-message id — matches {@link EmailEvent.resendEmailId} from webhooks.
   */
  resendEmailId  String?                      @unique
  /**
   * When this contact was added to the campaign's Resend segment (prepare phase).
   */
  resendSegmentSyncedAt DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([campaignId, emailContactId])
  @@index([campaignId])
  @@index([emailContactId])
}

/**
 * Append-only raw Resend webhook log for audit/debugging.
 */
model EmailEvent {
  id            String   @id @default(cuid())
  resendEmailId String?
  eventType     String
  payload       Json
  receivedAt    DateTime @default(now())

  @@index([resendEmailId])
  @@index([receivedAt])
}

/**
 * Paystack billing module — subscriptions, invoices, webhook audit.
 * Paystack is the payment rail; Subscription.status + Organization.plan drive access.
 */

enum SubscriptionStatus {
  /** No Paystack relationship yet (new org or enterprise manual). */
  NONE
  /** Card-free trial — Organization.plan may be PRO; not paying yet. */
  TRIALING
  /** Paying subscriber with a stored authorization. */
  ACTIVE
  /** Renewal charge failed — 3-day soft-lock grace before dunning exhausts. */
  PAST_DUE
  /** Cancelled or set not to renew — access until currentPeriodEnd. */
  CANCELLED
  /** Trial ended without payment — Organization.plan downgraded to FREE. */
  TRIAL_EXPIRED
  /** Dunning retries exhausted — login blocked (enforced Phase 4+). */
  SUSPENDED
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum BillingInvoiceSource {
  PAYSTACK
  MANUAL
  ENTERPRISE_PAYABLE
}

/**
 * Paystack customer record — one per organization.
 */
model BillingCustomer {
  id                   String       @id @default(cuid())
  orgId                String       @unique
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paystackCustomerCode String       @unique
  billingEmail         String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

/**
 * Billing relationship state for an org. Feature tier is on Organization.plan;
 * this row tracks Paystack subscription lifecycle separately.
 */
model Subscription {
  id                       String             @id @default(cuid())
  orgId                    String             @unique
  org                      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status                   SubscriptionStatus @default(NONE)
  /**
   * ISO currency for this subscription (GHS at launch).
   */
  currency                 String             @default("GHS")
  paystackSubscriptionCode String?            @unique
  paystackPlanCode         String?
  authorizationCode        String?
  /**
   * Paystack email_token — required to disable/enable the subscription via API.
   */
  emailToken               String?
  cardLast4                String?
  cardExpMonth             Int?
  cardExpYear              Int?
  /**
   * Set when Paystack sends subscription.expiring_cards; cleared on successful re-auth.
   */
  cardExpiringNotifiedAt   DateTime?
  trialStartsAt            DateTime?
  trialEndsAt              DateTime?
  trialReminderDay60SentAt DateTime?
  trialReminderDay80SentAt DateTime?
  trialReminderDay89SentAt DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  /**
   * ENTERPRISE only: set to currentPeriodEnd when coverage lapses with no new
   * paid window. Does not change plan/status/access — ops queue signal only.
   * Cleared when a future coverage window is applied.
   */
  coverageOverdueSince     DateTime?
  /**
   * Set when the one-time Enterprise coverage-overdue alert email was sent
   * (customer To + configured billing alert CCs).
   */
  enterpriseCoverageOverdueAlertSentAt DateTime?
  enterpriseCoverageReminderDay30SentAt DateTime?
  enterpriseCoverageReminderDay14SentAt DateTime?
  enterpriseCoverageReminderDay7SentAt  DateTime?
  enterpriseCoverageReminderDay3SentAt  DateTime?
  enterpriseCoverageReminderDay1SentAt  DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  /**
   * Last known Paystack subscription.status (active | non-renewing | cancelled | attention | complete).
   * Drive resume vs re-subscribe UI from this — not from our local CANCELLED enum alone.
   */
  paystackStatus           String?
  pastDueSince             DateTime?
  dunningAttempt           Int                @default(0)
  lastDunningAttemptAt     DateTime?
  nextDunningAt            DateTime?
  /**
   * When set, dunning cron skips this org until cleared (superadmin pause).
   */
  dunningPausedAt          DateTime?
  suspendedAt              DateTime?
  /**
   * Superadmin comp — distinct from card-free trial. While compEndsAt is in the
   * future, entitlements use compPlan (PRO/ENTERPRISE) regardless of Paystack.
   */
  compPlan                 OrgPlan?
  compEndsAt               DateTime?
  invoices                 BillingInvoice[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEnd])
  @@index([status, nextDunningAt])
  @@index([compEndsAt])
  @@index([coverageOverdueSince])
}

/**
 * Mirror of Paystack invoices for org billing history and superadmin ops.
 */
model BillingInvoice {
  id                  String               @id @default(cuid())
  orgId               String
  org                 Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId      String?
  subscription        Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paystackInvoiceCode String?              @unique
  /**
   * Paystack Payment Request code (PRQ_…) for Enterprise payable invoices.
   */
  paystackPaymentRequestCode String?       @unique
  /**
   * Hosted Paystack payment page for ENTERPRISE_PAYABLE (https://paystack.com/pay/PRQ_…).
   */
  paymentPageUrl      String?
  /**
   * Amount in pesewas (GHS smallest unit), matching Paystack API.
   * For ENTERPRISE_PAYABLE with VAT on: exclusive base + levies (total charged).
   * For subscription/mirrored charges: VAT-inclusive total.
   */
  amountPesewas       Int
  /**
   * Ghana VAT split, frozen at invoice creation (pesewas).
   * base + nhil + getfund + vat === amountPesewas.
   */
  baseAmountPesewas   Int                  @default(0)
  nhilAmountPesewas   Int                  @default(0)
  getfundAmountPesewas Int                 @default(0)
  vatAmountPesewas    Int                  @default(0)
  currency            String               @default("GHS")
  status              BillingInvoiceStatus @default(PENDING)
  /**
   * PAYSTACK = mirrored from Paystack charges/invoices;
   * MANUAL = superadmin offline;
   * ENTERPRISE_PAYABLE = Payment Request sent to customer.
   */
  source              BillingInvoiceSource @default(PAYSTACK)
  /**
   * Optional line items:
   * [{ description: string, amountPesewas: number }]
   * For ENTERPRISE_PAYABLE these are exclusive (pre-tax) amounts when VAT is applied.
   */
  lineItems           Json?
  /**
   * Enterprise payable: months of access granted when this invoice is paid.
   * Locked at create time — not guessed at payment.
   */
  coverageMonths     Int?
  /**
   * Optional explicit coverage end (overrides coverageMonths when set).
   */
  coverageEndsAt     DateTime?
  /**
   * When true, on pay extend from existing Enterprise currentPeriodEnd if it is
   * still in the future; otherwise start from paidAt. Never uses a leftover PRO
   * period — PRO→ENTERPRISE clears currentPeriodEnd when disabling the Paystack sub.
   */
  extendFromPriorCoverage Boolean @default(false)
  /**
   * Set when coverage was applied to Subscription.currentPeriodEnd (idempotent).
   */
  coverageAppliedAt  DateTime?
  paidAt              DateTime?
  dueDate             DateTime?
  periodStart         DateTime?
  periodEnd           DateTime?
  /**
   * Set when the payable Enterprise invoice email was sent (create/resend).
   */
  invoiceEmailSentAt  DateTime?
  /**
   * Set when the EventFlow payment receipt email was sent (idempotency).
   */
  receiptEmailSentAt  DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([orgId, createdAt])
  @@index([subscriptionId])
  @@index([orgId, source])
  @@index([orgId, status])
}

/**
 * Append-only Paystack webhook log — insert before processing for idempotency.
 */
model PaymentEvent {
  id              String        @id @default(cuid())
  paystackEventId String        @unique
  eventType       String
  /**
   * Best-effort org resolved from Paystack customer/subscription codes in payload.
   */
  orgId           String?
  org             Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  payload         Json
  processedAt     DateTime?
  processingError String?       @db.Text
  receivedAt      DateTime      @default(now())

  @@index([orgId, receivedAt])
  @@index([eventType, receivedAt])
  @@index([receivedAt])
}

/**
 * Superadmin billing ops audit — queryable per org. Separate from PaymentEvent
 * (which is Paystack webhook-only).
 */
model ManualBillingAction {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User         @relation("ManualBillingActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  /**
   * Stable action key, e.g. suspend, grant_comp, resync_paystack.
   */
  action      String
  reason      String       @db.Text
  beforeState Json
  afterState  Json
  metadata    Json?
  createdAt   DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/**
 * Singleton platform-wide settings (id = "default"). Editable by platform owners.
 */
model PlatformSettings {
  id                   String   @id @default("default")
  /**
   * Public support contact shown in billing emails / mailto links.
   * Not hardcoded — configure here.
   */
  supportEmail         String?
  /**
   * Addresses CC'd on PRO/Enterprise due alerts (trial reminders, Enterprise
   * coverage reminders, card-expiring). Typically platform owner + support.
   */
  billingAlertCcEmails String[] @default([])
  updatedAt            DateTime @updatedAt
  updatedByUserId      String?
}
