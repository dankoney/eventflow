// Prisma does not ship a native Windows-on-ARM query engine yet. If you see
// "query_engine-windows.dll.node is not a valid Win32 application" with Node arm64,
// use Node.js x64 on Windows ARM (emulated) or run the app in WSL2 / Linux and reinstall deps.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                             String                        @id @default(cuid())
  name                           String
  slug                           String                        @unique
  logo                           String?
  /**
   * Broadcast / marketing email branding (org-wide). Falls back to `logo` when unset.
   */
  logoUrl                        String?
  /**
   * Primary brand color for broadcast templates (buttons, header band). Default indigo.
   */
  primaryColor                   String                        @default("#4F46E5")
  /**
   * Optional accent for highlights; defaults to primary at send time when unset.
   */
  accentColor                    String?
  /**
   * Feature tier (FREE / PRO / ENTERPRISE) — what product capabilities the org
   * may use right now. Billing relationship state lives on Subscription.status;
   * feature gating must use getOrgBillingAccess() / orgCan(), not plan alone.
   */
  plan                           OrgPlan                       @default(FREE)
  /**
   * Set when the admin clicks the activation link in their welcome email.
   * Sign-in is blocked while this is null so a provisioned-but-unverified org
   * can't be used. Cleared again (back to null) ONLY by a platform owner — there
   * is no UI for self-deactivation.
   */
  activatedAt                    DateTime?
  /**
   * Audit pointer to the platform owner that minted this workspace. Null on the
   * very first org (bootstrapped via /setup) and any org migrated in by hand.
   */
  provisionedById                String?
  provisionedBy                  User?                         @relation("PlatformOwnerProvisionedOrgs", fields: [provisionedById], references: [id], onDelete: SetNull)
  activationTokens               OrgActivationToken[]
  zoomClientId                   String?
  zoomClientSecret               String?
  zoomAccountId                  String?
  /**
   * Zoom Meeting SDK app credentials (Marketplace → Meeting SDK). Used for in-app host
   * launch (JWT signature). Separate from Server-to-Server OAuth above.
   */
  zoomMeetingSdkKey              String?
  zoomMeetingSdkSecret           String?                       @db.Text
  whatsappEnabled                Boolean                       @default(false)
  whatsappAccessToken            String?                       @db.Text
  whatsappPhoneNumberId          String?
  resendApiKey                   String?                       @db.Text
  /**
   * mNotify (Ghana) — Quick SMS; https://api.mnotify.com
   */
  mnotifyEnabled                 Boolean                       @default(false)
  mnotifyApiKey                  String?                       @db.Text
  /**
   * Registered sender ID (max 11 characters on mNotify).
   */
  mnotifySenderId                String?
  /**
   * Default public registration / attendee branding for new events (wizard & classic create).
   */
  defaultEventBannerImageUrl     String?
  defaultEventBrandLogoUrl       String?
  defaultEventAttendeeTheme      AttendeeTheme                 @default(SYSTEM)
  defaultEventPublicPageTemplate PublicPageTemplate            @default(SUMMIT)
  defaultEventBrandPrimaryColor  String?
  defaultEventBrandSecondaryColor String?
  defaultEventBrandTertiaryColor  String?
  /**
   * Default virtual seat count when virtual is enabled on a new event.
   */
  defaultEventVirtualCapacity    Int                           @default(100)
  defaultZoomSessionKind         ZoomSessionKind               @default(MEETING)
  /**
   * Google Maps Platform API key (Places, Static Maps). Optional; falls back to GOOGLE_MAPS_API_KEY on server.
   */
  googleMapsApiKey               String?                       @db.Text
  /**
   * Preset contact category labels (string[]) for directory + audience filters; JSON array.
   */
  contactCategoryLabels          Json?
  /**
   * Shown on internal staff registration self check-in footer (e.g. \"MIS Department\").
   */
  internalStaffFooterContact     String?
  /**
   * When true, RSVP and public registration may show an optional marketing opt-in.
   */
  marketingEmailEnabled          Boolean                       @default(false)
  /**
   * Checkbox label shown to guests; supports {orgName} placeholder.
   */
  marketingConsentCopy           String?                       @db.Text
  /**
   * Linked from the marketing opt-in checkbox (https URL).
   */
  marketingPrivacyPolicyUrl      String?
  /**
   * Optional legal/company name for payment receipts (falls back to `name`).
   */
  billingLegalName               String?
  billingAddressLine1            String?
  billingAddressLine2            String?
  billingCity                    String?
  billingRegion                  String?
  billingPostalCode              String?
  billingCountry                 String?
  createdAt                      DateTime                      @default(now())
  events                         Event[]
  users                          User[]
  locations                      Location[]
  orgContacts                    OrgContact[]
  crmContactGroups               OrgContactGroup[]
  feedbackQuestionTemplates      OrgFeedbackQuestionTemplate[]
  mediaAssets                    MediaAsset[]
  emailTemplates                 EmailTemplate[]
  emailCampaigns                 EmailCampaign[]
  billingCustomer                BillingCustomer?
  subscription                   Subscription?
  billingInvoices                BillingInvoice[]
  paymentEvents                  PaymentEvent[]
  manualBillingActions           ManualBillingAction[]
}

/**
 * Central media library — org-scoped images, videos, and documents.
 */
model MediaAsset {
  id               String         @id @default(cuid())
  orgId            String
  org              Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedByUserId String?
  uploadedBy       User?          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  title            String
  originalName     String
  mimeType         String
  sizeBytes        Int
  kind             MediaAssetKind
  storagePath      String
  publicUrl        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, kind])
}

/**
 * Reusable optional-question sets for post-event guest feedback (per organization).
 */
model OrgFeedbackQuestionTemplate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?      @db.Text
  /**
   * JSON array: [{ key: string, prompt: string }]
   */
  questions   Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

/**
 * Organization-wide CRM record: people & org-facing stakeholders; guests link via contactId.
 */
model OrgContact {
  id               String                  @id @default(cuid())
  orgId            String
  org              Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  /**
   * Lowercased work email; unique per organization.
   */
  email            String
  /**
   * E.164 or normalized digits; unique per organization.
   */
  phone            String
  /**
   * Optional org-issued identifier (badge, employee ref, or external key).
   */
  staffEmployeeId  String?
  company          String?
  jobTitle         String?
  department       String?
  branch           String?
  category         String?
  rank             String?
  employmentStatus StaffEmploymentStatus   @default(PERMANENT)
  dateJoined       DateTime                @default(now())
  hasWhatsapp      Boolean                 @default(false)
  userId           String?                 @unique
  user             User?                   @relation("OrgContactToUser", fields: [userId], references: [id], onDelete: SetNull)
  guests           Guest[]
  /**
   * CRM classification (attendee, stakeholder, sponsor, …).
   */
  crmKind          CrmContactKind          @default(OTHER)
  /**
   * Pipeline / relationship stage (free text; e.g. prospect, active, alumni).
   */
  lifecycleStage   String?                 @db.VarChar(48)
  /**
   * Rich notes for relationship context.
   */
  notes            String?                 @db.Text
  /**
   * JSON string[] — segments / topics (max length enforced in app).
   */
  tags             Json?
  linkedinUrl      String?                 @db.VarChar(512)
  website          String?                 @db.VarChar(512)
  /**
   * How this record entered the CRM: manual, import_csv, sync_guest, registration, …
   */
  source           String?                 @db.VarChar(120)
  groupMembers     OrgContactGroupMember[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@index([orgId])
  @@index([orgId, crmKind])
}

/**
 * Segments / lists for campaigns and internal audience (many contacts per group).
 */
model OrgContactGroup {
  id          String                  @id @default(cuid())
  orgId       String
  org         Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?                 @db.Text
  /**
   * Optional UI chip color (#RRGGBB).
   */
  color       String?                 @db.VarChar(7)
  members     OrgContactGroupMember[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([orgId])
}

model OrgContactGroupMember {
  id        String          @id @default(cuid())
  groupId   String
  group     OrgContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId String
  contact   OrgContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([groupId, contactId])
  @@index([contactId])
}

model Location {
  id               String       @id @default(cuid())
  name             String
  address          String
  capacity         Int
  /**
   * Locality for venue search (e.g. from Places).
   */
  city             String?
  latitude         Float?
  longitude        Float?
  googlePlaceId    String?
  /**
   * Public URL path (e.g. /uploads/venues/…) shown on registration.
   */
  facilityImageUrl String?
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events           Event[]
  createdAt        DateTime     @default(now())
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  emailVerified          DateTime?
  image                  String?
  role                   Role                    @default(STAFF)
  orgId                  String
  org                    Organization            @relation(fields: [orgId], references: [id])
  /**
   * Platform-level superadmin flag. Orthogonal to the org-scoped {@link Role}:
   * a platform owner is still ADMIN of *their* workspace, but additionally has
   * access to /superadmin (provision new orgs, see all workspaces). Flipped on
   * the seed user by the `20260511200000_platform_org_provisioning` migration;
   * managed manually thereafter (no UI).
   */
  isPlatformOwner        Boolean                 @default(false)
  accounts               Account[]
  sessions               Session[]
  linkedOrgContact       OrgContact?             @relation("OrgContactToUser")
  provisionedOrgs        Organization[]          @relation("PlatformOwnerProvisionedOrgs")
  activationTokens       OrgActivationToken[]
  guestMessageCampaigns  GuestMessageCampaign[]
  eventFeedbackCampaigns EventFeedbackCampaign[]
  eventsCreated          Event[]                 @relation("EventCreatedBy")
  eventTeamMemberships   EventTeamMember[]
  guestsCreated          Guest[]                 @relation("GuestCreatedBy")
  uploadedMediaAssets    MediaAsset[]
  emailTemplatesCreated  EmailTemplate[]         @relation("EmailTemplateCreatedBy")
  emailCampaignsCreated  EmailCampaign[]         @relation("EmailCampaignCreatedBy")
  manualBillingActions   ManualBillingAction[]   @relation("ManualBillingActionActor")
  createdAt              DateTime                @default(now())
}

/**
 * Post-event feedback request blast to checked-in / joined guests.
 */
model EventFeedbackCampaign {
  id               String                  @id @default(cuid())
  eventId          String
  event            Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByUserId  String
  createdBy        User                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  recipientCount   Int                     @default(0)
  sentCount        Int                     @default(0)
  failedCount      Int                     @default(0)
  skippedCount     Int                     @default(0)
  /**
   * Guest ids targeted by this blast (for scoped follow-up metrics).
   */
  audienceGuestIds Json?
  responses        EventFeedbackResponse[]
  createdAt        DateTime                @default(now())

  @@index([eventId, createdAt])
}

/**
 * One emoji rating per guest per event (updated if they submit again).
 */
model EventFeedbackResponse {
  id                   String                 @id @default(cuid())
  eventId              String
  event                Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId              String?
  guest                Guest?                 @relation(fields: [guestId], references: [id], onDelete: Cascade)
  /**
   * Set for anonymous portal submissions (`/feedback/anon/...`).
   */
  portalAnonymousToken String?                @unique
  campaignId           String?
  campaign             EventFeedbackCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  rating               EventFeedbackRating
  comment              String?                @db.Text
  /**
   * Map of organizer feedback question key -> guest-provided answer.
   * Stored as JSON to avoid extra tables.
   */
  answers              Json?
  /**
   * When true, organizers see this response without the guest name (guestId may still be set for tracking).
   */
  submittedAnonymously Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([eventId, guestId])
  @@index([eventId, rating])
}

/**
 * Organizer-initiated custom SMS or email to one guest or a blast to many.
 */
model GuestMessageCampaign {
  id                String                    @id @default(cuid())
  eventId           String
  event             Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdBy         User                      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  channel           GuestMessageChannel
  scope             GuestMessageCampaignScope @default(SINGLE)
  templateSubject   String?
  templateHeadline  String?
  templateBody      String                    @db.Text
  recipientCount    Int                       @default(0)
  sentCount         Int                       @default(0)
  failedCount       Int                       @default(0)
  skippedCount      Int                       @default(0)
  mnotifyCampaignId String?
  deliveries        GuestMessageDelivery[]
  createdAt         DateTime                  @default(now())

  @@index([eventId, createdAt])
}

model GuestMessageDelivery {
  id         String                     @id @default(cuid())
  campaignId String
  campaign   GuestMessageCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest                      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  status     GuestMessageDeliveryStatus
  error      String?                    @db.Text
  sentAt     DateTime?
  createdAt  DateTime                   @default(now())

  @@index([campaignId])
  @@index([guestId])
}

/**
 * Single-use email-verification + workspace-activation token. Minted when a
 * platform owner provisions a new org; consumed when the admin clicks the
 * "Activate workspace" button in their welcome email. Stored as a bcrypt hash
 * (same posture as poll OTPs) so a leaked row doesn't grant access.
 * Each (orgId, userId) typically has 1 active row at a time. Resending the
 * activation email marks any existing rows for that pair as consumed before
 * minting a fresh one — guaranteeing the most recent link is the only one
 * that still works.
 */
model OrgActivationToken {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([orgId, userId, consumedAt])
  @@index([expiresAt])
}

model Event {
  id                             String                     @id @default(cuid())
  name                           String
  description                    String?
  date                           DateTime
  endDate                        DateTime
  scheduleMode                   EventScheduleMode          @default(SINGLE_BLOCK)
  /**
   * Validated MultiDayConfig JSON when scheduleMode is MULTI_DAY.
   */
  multiDayConfig                 Json?
  locationId                     String
  location                       Location                   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  capacity                       Int
  virtualCapacity                Int                        @default(0)
  type                           EventType                  @default(IN_PERSON)
  status                         EventStatus                @default(DRAFT)
  zoomMeetingId                  String?
  zoomJoinUrl                    String?
  /**
   * Host start URL from Zoom API — dashboard / Meeting SDK only; never sent to guests.
   */
  zoomStartUrl                   String?
  zoomPasscode                   String?
  zoomSessionKind                ZoomSessionKind            @default(WEBINAR)
  reminderPrimaryEnabled         Boolean                    @default(true)
  reminderPrimaryHoursBefore     Int                        @default(24)
  reminderPrimaryEmail           Boolean                    @default(true)
  reminderPrimaryWhatsapp        Boolean                    @default(false)
  reminderPrimarySms             Boolean                    @default(false)
  reminderFinalEnabled           Boolean                    @default(true)
  reminderFinalHoursBefore       Int                        @default(2)
  reminderFinalWhatsapp          Boolean                    @default(true)
  reminderFinalSms               Boolean                    @default(false)
  /**
   * Blueprint-first wizard template (Bizzabo-style program archetypes).
   */
  blueprintTemplate              EventBlueprintTemplate     @default(BLANK)
  /**
   * When false, public /register page is invite-only (e.g. internal staff events).
   */
  allowPublicRegistration        Boolean                    @default(true)
  /**
   * When true (default), registration forms require a valid email. When false, phone alone is sufficient.
   */
  emailMandatoryForRegistration  Boolean                    @default(true)
  /**
   * When true, the org Command Center (`/o/[orgSlug]`) may create walk-in guests for this event
   * if the entered email does not match an existing guest or CRM contact.
   * Internal staff programs default this off in the wizard; conferences default on.
   */
  allowFlashEntry                Boolean                    @default(true)
  /**
   * Registration field policy: requireCompany, requireJobTitle, requireStaffId, requireDepartment, enableSavedProfileLookup.
   */
  registrationProfile            Json?
  /**
   * Optional custom public registration form definition (field types, labels). v1 JSON schema in app code.
   */
  customRegistrationForm         Json?
  /**
   * Conference template: hotel / travel notes.
   */
  accommodationTravelNotes       String?                    @db.Text
  /**
   * Training template: session materials as { title, url }[].
   */
  resourceLinks                  Json?
  /**
   * Public attendee page enhancements: agenda, speakers, resources, and optional venue extras.
   */
  publicExperience               Json?
  /**
   * Internal staff template: audience rules JSON (see internalStaffAudienceSchema).
   */
  internalStaffAudience          Json?
  /**
   * Internal staff notice type — drives memo subject and session wording (training, sensitization, etc.).
   */
  internalStaffNoticeKind        InternalStaffNoticeKind    @default(TRAINING)
  /**
   * Memo TO line, e.g. "ALL STAFF". When null, derived from audience rules at send time.
   */
  internalStaffNoticeTo          String?
  /**
   * Memo FROM line, e.g. "HEAD, HUMAN RESOURCES & ADMINISTRATION".
   */
  internalStaffNoticeFrom        String?
  /**
   * Memo CC line, e.g. "CHIEF EXECUTIVE OFFICER".
   */
  internalStaffNoticeCc          String?
  /**
   * Opening context / rationale paragraph for the staff notice (legal background, purpose).
   */
  internalStaffNoticeContext     String?                    @db.Text
  /**
   * Optional memo subject override. When null, derived from notice kind + event name.
   */
  internalStaffNoticeSubject     String?                    @db.VarChar(500)
  /**
   * Meeting room / room name for in-person and hybrid programmes (shown in venue line).
   */
  internalStaffMeetingRoom       String?                    @db.VarChar(240)
  /**
   * Email template selection for mandatory-attendance staff notices.
   */
  internalStaffEmailTemplateKind InternalStaffEmailTemplateKind @default(MEMORANDUM)
  /**
   * SMS template selection for mandatory-attendance staff notices.
   */
  internalStaffSmsTemplateKind   InternalStaffSmsTemplateKind   @default(STANDARD)
  /**
   * Optional custom SMS text when using BLANK SMS template.
   */
  internalStaffSmsCustomText    String?                    @db.Text
  /**
   * Maily editor JSON for BLANK staff notice emails (full custom memo body).
   */
  internalStaffEmailMailyJson   Json?
  /**
   * Internal staff: shared staff ID/email check-in vs personal links only (prevents proxy check-in).
   */
  internalStaffCheckInMode       InternalStaffCheckInMode   @default(PERSONAL_LINK)
  /**
   * Internal staff: show meal menu on self check-in and store choice on the check-in row.
   */
  internalStaffMealMenuEnabled   Boolean                    @default(false)
  /**
   * One list for everyone vs different lists per branch (guest.branch / directory).
   */
  internalStaffMealMenuScope     InternalStaffMealMenuScope @default(ALL_STAFF)
  /**
   * Internal staff: JSON string[] of meal labels when scope is ALL_STAFF.
   */
  internalStaffMealMenuItems     Json?
  /**
   * Internal staff: JSON [{ branch: string, items: string[] }] when scope is BY_BRANCH.
   */
  internalStaffMealMenusByBranch Json?
  /**
   * 21:9 style hero for registration / PWA contexts (https URL).
   */
  bannerImageUrl                 String?
  brandLogoUrl                   String?
  attendeeTheme                  AttendeeTheme              @default(SYSTEM)
  /**
   * Public registration page layout template (independent of light/dark color mode on Template 1).
   */
  publicPageTemplate             PublicPageTemplate         @default(SUMMIT)
  /**
   * Hex color e.g. #0f172a for attendee touchpoints.
   */
  brandPrimaryColor              String?
  orgId                          String
  org                            Organization               @relation(fields: [orgId], references: [id])
  guests                         Guest[]
  guestGroups                    EventGuestGroup[]
  reminderLogs                   EventReminderLog[]
  waitlistEntries                EventWaitlistEntry[]
  /**
   * Election & polling add-on (1-1). Created lazily when an organizer opens the poll tab.
   */
  poll                           Poll?
  pollVerifications              PollVerification[]
  guestMessageCampaigns          GuestMessageCampaign[]
  feedbackCampaigns              EventFeedbackCampaign[]
  feedbackResponses              EventFeedbackResponse[]
  /**
   * Optional organizer-defined post-event feedback questions.
   * JSON shape: [{ key: string, prompt: string }]
   */
  feedbackQuestions              Json?
  /**
   * When true, admin feedback views and exports hide guest name/email per response.
   */
  feedbackAnonymous              Boolean                    @default(false)
  /**
   * Short code for the public feedback portal (`/fb/[feedbackShortCode]`).
   * Guests enter their email on that page to open their personal feedback form.
   */
  feedbackShortCode              String?                    @unique
  capacityAlerts                 EventCapacityAlert[]
  teamMembers                    EventTeamMember[]
  createdByUserId                String?
  createdBy                      User?                      @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
}

/**
 * Dedupes venue capacity alert emails/SMS to org admins (80% and 100% thresholds per session day).
 */
model EventCapacityAlert {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dayIndex  Int
  /**
   * Percent threshold that triggered the alert (e.g. 80 or 100).
   */
  threshold Int
  sentAt    DateTime @default(now())

  @@unique([eventId, dayIndex, threshold])
  @@index([eventId])
}

model EventReminderLog {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind     String
  anchorAt DateTime
  sentAt   DateTime @default(now())

  @@unique([eventId, kind, anchorAt])
}

/**
 * Phase F waitlist: entries that registered after capacity was full. When a guest
 * declines (or is removed), the next WAITING entry by `position` is promoted to a
 * Guest with status INVITED + invitationToken, and the smart invitation email
 * fires (subject to publish gating).
 */
model EventWaitlistEntry {
  id                String         @id @default(cuid())
  eventId           String
  event             Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email             String
  name              String
  phone             String?
  company           String?
  preferredMode     AttendMode?
  position          Int
  status            WaitlistStatus @default(WAITING)
  notifiedAt        DateTime?
  promotedToGuestId String?        @unique
  createdAt         DateTime       @default(now())

  @@unique([eventId, email])
  @@index([eventId, status, position])
}

model EventGuestGroup {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  guests    Guest[]
  createdAt DateTime @default(now())

  @@unique([eventId, name])
  @@index([eventId])
}

model Guest {
  id                        String                  @id @default(cuid())
  name                      String
  email                     String?
  phone                     String?
  contactId                 String?
  contact                   OrgContact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company                   String?
  jobTitle                  String?
  tier                      Tier                    @default(C)
  /**
   * Null until guest chooses (hybrid) or is set at venue check-in vs virtual join.
   */
  mode                      AttendMode?
  status                    GuestStatus             @default(INVITED)
  /**
   * One-time token for invitation accept link (organizer-added guests).
   */
  invitationToken           String?                 @unique
  /**
   * When the organizer invitation email was sent (null until publish for draft events).
   */
  invitationEmailSentAt     DateTime?
  /**
   * Internal staff roster notice email (memo-style; not an RSVP invite).
   */
  staffBriefingSentAt       DateTime?
  /**
   * Internal staff roster notice SMS companion.
   */
  staffBriefingSmsSentAt    DateTime?
  /**
   * Decline / "I Can't Make It" capture from the smart-invitation page.
   */
  declineReason             RsvpDeclineReason?
  declineNote               String?                 @db.Text
  declinedAt                DateTime?
  /**
   * When set, skip all subsequent reminder dispatch (set on decline; cleared if guest re-registers).
   */
  notificationsSuppressedAt DateTime?
  /**
   * Smart-RSVP confirmation: when the guest accepted the invitation, used to gate the
   * unified confirmation email + persist any accommodation upsell choice.
   */
  rsvpConfirmedAt           DateTime?
  /**
   * Conference accommodation upsell: did the guest request hotel/lodging support?
   */
  accommodationRequested    Boolean                 @default(false)
  /**
   * Free-form preferences captured at RSVP (check-in/out dates, room type, dietary, etc).
   */
  accommodationDetails      String?                 @db.Text
  eventGuestGroupId         String?
  eventGuestGroup           EventGuestGroup?        @relation(fields: [eventGuestGroupId], references: [id], onDelete: SetNull)
  /**
   * REGISTERED = normal RSVP; EXTERNAL_JOIN = created from Zoom participant report (walk-in);
   * WALK_IN = created from the org Command Center when flash entry is allowed and email did not match CRM.
   */
  joinSource                GuestJoinSource         @default(REGISTERED)
  /**
   * Zoom report `participants[].id` — used to dedupe walk-ins without email on re-sync.
   */
  zoomParticipantReportId   String?
  /**
   * One-time internal staff check-in token when event uses PERSONAL_LINK mode.
   */
  internalCheckInToken      String?                 @unique @db.VarChar(128)
  qrCode                    String?                 @unique
  zoomLink                  String?
  dietary                   String?
  /**
   * ISO 3166-1 alpha-2 or organizer-defined free text from imports.
   */
  country                   String?
  accessibilityNotes        String?
  referralSource            String?
  staffEmployeeId           String?
  department                String?
  /**
   * Office/location branch (e.g. from staff directory); used for branch-scoped meal menus.
   */
  branch                    String?
  repId                     String?
  /**
   * User who created this guest record (walk-in kiosk, manual add). Used for staff session-scoped PII.
   */
  createdByUserId           String?
  createdBy                 User?                   @relation("GuestCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /**
   * Auth session id when a Staff user created this walk-in; PII visible only while session matches.
   */
  staffVisibleSessionId     String?
  /**
   * Election & polling add-on: flipped to true when this guest has cast a ballot for the
   * event's {@link Poll}. The anonymized {@link Vote} table is intentionally NOT linked
   * back to Guest (secret ballot). When the poll is non-anonymous, {@link BallotChoice}
   * rows additionally record the attributed selections. This flag is the only Guest-side
   * trace of participation in BOTH modes.
   */
  hasVoted                  Boolean                 @default(false)
  eventId                   String
  event                     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns                  CheckIn[]
  pollVerifications         PollVerification[]
  /**
   * Attributed ballot rows for non-anonymous polls. Always empty when the poll for
   * this guest's event has `Poll.isAnonymous = true`.
   */
  ballotChoices             BallotChoice[]
  messageDeliveries         GuestMessageDelivery[]
  /**
   * Magic-link token for post-event emoji feedback (`/feedback/[guestId]/[token]`).
